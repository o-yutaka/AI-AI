# Core runtime
CORS_ORIGINS=http://localhost:3000
AGENT_DB_PATH=.data/control-plane.sqlite3

# OpenAI-compatible candidate planner
# The model proposes candidates only. Runtime policy remains authoritative.
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_MODEL=replace-with-model-id
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=30

# Optional allow-listed HTTP tool adapters.
# Keep real tokens outside this file. Header placeholders are resolved from the environment.
TOOL_ADAPTERS_JSON={"support_api":{"base_url":"https://api.example.com","headers":{"Authorization":"Bearer ${SUPPORT_API_TOKEN}"},"operations":{"reply":{"method":"POST","path":"/tickets/{ticket_id}/reply","payload_mode":"json"}}}}
SUPPORT_API_TOKEN=replace-me

# Frontend build-time API endpoint
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
