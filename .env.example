# Core runtime
CORS_ORIGINS=http://localhost:3000
AGENT_DB_PATH=.data/control-plane.sqlite3

# Comma-separated keys rejected from action payloads and redacted from traces.
# Defaults already include authorization, cookie, password, token, api key,
# email, phone, and address variants. Add domain-specific keys here.
TRACE_REDACTION_KEYS=customer_name,date_of_birth

# OpenAI-compatible candidate planner
# The model proposes candidates only. Runtime policy remains authoritative.
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_MODEL=replace-with-model-id
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=30
OPENAI_COMPATIBLE_MAX_RESPONSE_BYTES=524288

# Optional allow-listed HTTP tool adapters.
# Keep real tokens outside this file. Header placeholders are resolved from the environment.
TOOL_ADAPTERS_JSON={"support_api":{"base_url":"https://api.example.com","headers":{"Authorization":"Bearer ${SUPPORT_API_TOKEN}"},"max_response_bytes":262144,"operations":{"reply":{"method":"POST","path":"/tickets/{ticket_id}/reply","payload_mode":"json"}}}}
SUPPORT_API_TOKEN=replace-me

# Frontend build-time API endpoint
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
